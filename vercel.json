{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php"
    },
    {
      "source": "/reading",
      "destination": "/api/reading.php"
    },
    {
      "source": "/content",
      "destination": "/api/content.php"
    },
    {
      "source": "/epilogue",
      "destination": "/api/epilogue.php"
    }
  ]
}
